# Dev runner env -> copy to ~/kharcha/.env.dev (chmod 600). Used by make dev-api / dev-worker / backend-test.
# Shares the hosted Postgres/Redis/MinIO containers but uses separate databases, Redis DB 1 and its own bucket.
DATABASE_URL=postgresql+psycopg://kharcha:change-me@127.0.0.1:5432/kharcha_dev
TEST_DATABASE_URL=postgresql+psycopg://kharcha:change-me@127.0.0.1:5432/kharcha_test
REDIS_URL=redis://127.0.0.1:6379/1
QUEUE_PREFIX=dev-
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=originals-dev
MINIO_ROOT_USER=kharcha
MINIO_ROOT_PASSWORD=change-me-minio
JWT_SECRET=dev-secret
ERP_BASE_URL=http://127.0.0.1:8090
FORENSICS_URL=http://127.0.0.1:8085
LLM_MODE=stub                  # switch to live only when a task needs real NVIDIA calls
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=same-as-hosted
