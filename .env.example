# Hosted stack env -> copy to /opt/kharcha/.env (chmod 600). Never commit. PRD §26, SPEC §1.
DOMAIN=kharcha.example.duckdns.org
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kharcha:change-me@postgres:5432/kharcha
REDIS_URL=redis://redis:6379/0
QUEUE_PREFIX=
STORAGE_DIR=/data/originals       # docker volume `originals`
JWT_SECRET=generate-64-random-bytes
ERP_BASE_URL=http://mock-erp:8090
FORENSICS_URL=http://forensics:8085
LLM_MODE=live                  # live | stub
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=generate-random-key
NVIDIA_API_KEY=nvapi-...
